<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text_secondary"
            android:background="@drawable/bg_circle_icon"
            android:padding="10dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Назад" />

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сессия"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- Duration chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp">

        <TextView android:id="@+id/chip2"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="2 мин" android:textColor="@color/text_primary" android:textSize="13sp"
            android:background="@drawable/bg_btn_ghost" android:gravity="center"
            android:paddingHorizontal="16dp" android:layout_marginEnd="8dp" />

        <TextView android:id="@+id/chip5"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="5 мин" android:textColor="@color/text_primary" android:textSize="13sp"
            android:background="@drawable/bg_btn_ghost" android:gravity="center"
            android:paddingHorizontal="16dp" android:layout_marginEnd="8dp" />

        <TextView android:id="@+id/chip10"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="10 мин" android:textColor="@color/text_primary" android:textSize="13sp"
            android:background="@drawable/bg_btn_primary" android:gravity="center"
            android:paddingHorizontal="16dp" android:layout_marginEnd="8dp" />

        <TextView android:id="@+id/chip20"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="20 мин" android:textColor="@color/text_primary" android:textSize="13sp"
            android:background="@drawable/bg_btn_ghost" android:gravity="center"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <!-- Breath circle -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <ImageView
            android:id="@+id/breathRing"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:src="@drawable/bg_breath_circle"
            android:alpha="0.18" />

        <ImageView
            android:id="@+id/breathCircle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:src="@drawable/bg_breath_circle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00"
                android:textColor="@color/text_primary"
                android:textSize="48sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_inhale"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="24dp">

        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/session_pause"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:background="@drawable/bg_btn_ghost"
            android:stateListAnimator="@null"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/session_finish"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
